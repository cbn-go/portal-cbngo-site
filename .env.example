APP_NAME="CBN Goiás"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Banco MySQL compartilhado com o painel administrativo (cbn-go/portal-cbngo-admin).
# O painel é o dono do schema: o deploy do portal NUNCA executa `php artisan migrate`.
# Em produção, use um usuário somente leitura:
#   CREATE USER 'cbngo_site'@'%' IDENTIFIED BY '...';
#   GRANT SELECT ON cbngo.* TO 'cbngo_site'@'%';
# Para desenvolvimento sem o painel, use DB_CONNECTION=sqlite e `php artisan migrate --seed`
# (carrega o espelho do schema em database/migrations/testing).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cbngo
DB_USERNAME=cbngo_site
DB_PASSWORD=

# URL pública do storage de mídia do painel (uploads salvos como caminhos relativos).
MEDIA_URL=https://midia.cbngo.org.br

# URL do painel administrativo / Área das Igrejas.
CBNGO_PANEL_URL=https://painel.cbngo.org.br

# Sessão, cache e fila ficam fora do banco: o usuário de banco do portal só tem SELECT.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

# Tempo (s) de cache do sitemap.xml; conteúdo publicado no painel aparece nesse prazo.
SITEMAP_CACHE_TTL=600

MAIL_MAILER=log
MAIL_FROM_ADDRESS="contato@cbngo.com.br"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
